{
	"name": "portfolio-website",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --plugin-search-dir . --check .",
		"format": "prettier --plugin-search-dir . --write .",
		"prepare": "husky",
		"db": "cd database && sqlite3 local.db",
		"seed": "cd database && sqlite3 local.db < seed.sql",
		"mock": "cd database && sqlite3 local.db < mock.sql",
		"post": "python3 tools/post.py"
	},
	"devDependencies": {
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/markdown-it": "^14.1.2",
		"@types/node": "^26.6.3",
		"husky": "^9.1.7",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"vite": "^8.3.1"
	},
	"type": "module",
	"dependencies": {
		"@fortawesome/free-brands-svg-icons": "^7.3.1",
		"@fortawesome/free-regular-svg-icons": "^7.3.1",
		"@fortawesome/free-solid-svg-icons": "^7.3.1",
		"@giscus/svelte": "^3.1.0",
		"@libsql/client": "^0.18.0",
		"@mdit/plugin-mathjax": "^1.2.2",
		"@netlify/functions": "^6.0.0",
		"@sveltejs/adapter-netlify": "^6.0.4",
		"es6-crawler-detect": "^4.0.2",
		"front-matter": "^4.0.2",
		"markdown-it": "^14.1.1",
		"my-ua-parser": "^2.0.4",
		"shiki": "^4.4.3",
		"svelte-fa": "^4.0.4",
		"valibot": "^1.5.0"
	}
}
